#
# Git LFS objects of this repository live on the Optimey LFS server, not on GitHub.
# Anyone can download them; uploads only work from the Optimey network.
# A repository made from this template: change the name in the url to its own name,
# and ask for an LFS repository of that name on the server.
# Without git-lfs you get small pointer files instead of the real files.
[lfs]
	url = https://lfs-github.optimey.be/Optimey-CommV/tool-template.git/info/lfs
	locksverify = false
